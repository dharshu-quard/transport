# TamilNadu Transit 360 AI Configuration
PROJECT_NAME="TamilNadu Transit 360 AI"
APP_ENV=development
DEBUG=True
SECRET_KEY=tnstc-transit-360-super-secret-key-production-change-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Dev OTP override for seamless testing
DEV_OTP=123456

# Database (PostgreSQL default in docker; automatic SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./transit360.db
DATABASE_SYNC_URL=sqlite:///./transit360.db

# QR HMAC Signing Secret
QR_SIGNING_SECRET=transit-360-tamper-proof-qr-secret-key-chennai-2026

# Server Ports
BACKEND_PORT=8000
ADMIN_WEB_PORT=5173
MOBILE_WEB_PORT=8081

# Mock Adapters
MOCK_FCM=true
MOCK_PAYMENT_GATEWAY=true
MOCK_GOV_REGISTRY=true
ENABLE_GPS_SIMULATOR=true
